# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
venv/
.venv/
__pycache__/

# --- Build output ---
dist/
build/
.next/
out/
coverage/

# --- Next.js / TypeScript / Vercel ---
next-env.d.ts
*.tsbuildinfo
.vercel

# --- Generated Prisma client (rebuilt by `npm install` / `prisma generate`) ---
src/generated/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Local databases ---
*.sqlite
*.sqlite3
*.db

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code local settings ---
.claude/settings.local.json

# --- Load-test session tokens (never commit) ---
tests/load/.tokens.json
