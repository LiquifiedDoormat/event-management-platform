# Copy to .env and fill in real values locally: cp .env.example .env
# NEVER commit .env. This file contains placeholders only.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser. Never put secrets in them.

# --- App ---
# Public base URL. Used to check the Origin header on state-changing requests.
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Local Docker database (npm run db:up). Pick any password; it is only used locally.
POSTGRES_PASSWORD=<choose-a-local-password>
DATABASE_URL=postgresql://event:<choose-a-local-password>@localhost:5432/event_dev
# Optional, production: direct (non-pooled) connection used only by migrations.
# DIRECT_DATABASE_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
# Separate database used by integration tests (created automatically by Docker).
TEST_DATABASE_URL=postgresql://event:<choose-a-local-password>@localhost:5432/event_test

# --- Scheduled jobs ---
# Random secret Vercel Cron sends to /api/cron/prune (generate: openssl rand -hex 32).
CRON_SECRET=<random-secret>

# --- Phone OTP ---
# "dev" logs OTPs to the server console and accepts them locally. Refused in production.
# "twilio" uses Twilio Verify (https://www.twilio.com/docs/verify).
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_VERIFY_SERVICE_SID=<twilio-verify-service-sid>

# --- Realtime (Pusher Channels, https://pusher.com/channels) ---
PUSHER_APP_ID=<pusher-app-id>
PUSHER_SECRET=<pusher-secret>
NEXT_PUBLIC_PUSHER_KEY=<pusher-key>
NEXT_PUBLIC_PUSHER_CLUSTER=<pusher-cluster, e.g. ap2>

# --- Google Maps Platform ---
# Browser key: restrict to your domains (HTTP referrers) and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<restricted-browser-key>
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=<map-id>
