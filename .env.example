# Copy this file to .env and fill in real values locally.
# NEVER commit .env. This file must contain placeholders only.

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>

# Authentication
SESSION_SECRET=<generate-a-long-random-string>
JWT_SECRET=<generate-a-long-random-string>
OTP_SECRET=<generate-a-random-base32-secret>

# Email (event invites / notifications)
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASSWORD=<smtp-password>

# Third-party APIs
PAYMENT_API_KEY=<your-payment-provider-key>
