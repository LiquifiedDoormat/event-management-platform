// Database schema for the Event Management Platform.
// See docs/DATABASE.md for design notes. Constraints Prisma cannot express
// (partial unique indexes, CHECK constraints) live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  CLUSTER_COORDINATOR
  COORDINATOR
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum Locale {
  en
  hi
}

/// Operational status shown to attendees. Set by the trip coordinator.
/// The bus's leg within one trip. A trip may start at either boarding point
/// (venue-bound in the evening, hotel-bound in the morning) and then only
/// advances forward through its own direction — see server/services/trips.ts
/// for the enforced transition table. Delayed/cancelled are not states here;
/// they're Trip.isDelayed/Trip.cancelled, since either can apply at any leg.
enum BusStatus {
  BOARDING_AT_VENUE
  DEPARTED_VENUE
  ARRIVED_AT_HOTEL
  BOARDING_AT_HOTEL
  DEPARTED_HOTEL
  ARRIVED_AT_VENUE
}

/// One attendee movement: checking in/out at the venue, or boarding/departing a bus.
enum AttendanceType {
  CHECK_IN
  CHECK_OUT
  BOARD
  DEPART
}

/// A guest's mark within one dated attendance session for a bus.
enum AttendanceMark {
  BOARDED
  ABSENT
}

/// Every person with an account: owner, admins, coordinators, attendees.
model User {
  id              String        @id @default(cuid())
  /// E.164 format, e.g. +919876543210. Login identifier — but NOT unique: an
  /// attendee phone may be shared by several guests (e.g. a family travelling
  /// together), each their own row. Staff/coordinator accounts are still kept
  /// effectively one-per-phone at the application level (see createPerson) —
  /// their sign-in has no "choose which guest" step and wouldn't make sense
  /// shared. See PROJECT_MEMORY.md's Phase 3 entry.
  phone           String
  name            String
  role            Role          @default(CUSTOMER)
  status          AccountStatus @default(ACTIVE)
  preferredLocale Locale        @default(en)
  /// Postal address (attendees only). Sensitive PII: gated to Owner/Admin and
  /// the attendee themselves — see canViewAddress in policies/index.ts.
  address         String?       @db.Text
  /// Medical needs/conditions (attendees only). Visible/editable by staff, the
  /// attendee themselves, and their hotel coordinator — see canEditMedicalNeeds
  /// in policies/index.ts. A narrower gate than address: coordinators act on this.
  medicalNeeds    String?       @db.Text
  /// Free text, not a fixed enum — avoids forcing a choice that doesn't fit.
  /// Attendees only, like address/medicalNeeds.
  gender          String?
  /// scrypt hash of the 6-digit PIN (Owner/Admin/Coordinator only). Never the PIN itself.
  /// Null = the person chooses a PIN at their next sign-in (new account or admin reset).
  pinHash           String?
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships      EventMember[]

  designatedBuses  Bus[]            @relation("BusCoordinator")
  trips            Trip[]
  statusEvents     BusStatusEvent[]
  attendanceEvents AttendanceEvent[] @relation("AttendanceSubject")
  recordedAttendance AttendanceEvent[] @relation("AttendanceRecorder")
  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionCreator")
  coordinatorAssignments        BusCoordinatorAssignment[] @relation("BusCoordinatorAssignment")
  coordinatorAssignmentsCreated BusCoordinatorAssignment[] @relation("BusCoordinatorAssignmentCreator")
  attendanceRecords         AttendanceRecord[]  @relation("AttendanceRecordSubject")
  attendanceRecordsRecorded AttendanceRecord[]  @relation("AttendanceRecordRecorder")
  sessions         Session[]
  auditLogs        AuditLog[]

  @@index([phone])
  @@index([role, status])
  @@index([name])
}

/// An independent event. Hotels (and through them buses and trips) belong to one event.
model Event {
  id               String    @id @default(cuid())
  name             String
  startsOn         DateTime? @db.Date
  endsOn           DateTime? @db.Date
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotels           Hotel[]
  clusters         Cluster[]
  zones            Zone[]
  gates            Gate[]
  members          EventMember[]
  sessions         Session[]
  attendanceEvents AttendanceEvent[]
  attendanceSessions AttendanceSession[]

  @@index([isActive, name])
}

/// A seating/venue section attendees are assigned to (Phase 5). Optional: an
/// attendee with no zone is simply unassigned, never an error.
model Zone {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  name      String
  capacity  Int?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gates   Gate[]
  members EventMember[]

  @@index([eventId, isActive, name])
}

/// An entry/exit point at the venue. Optionally linked to the zone it serves;
/// a zone-less gate is a general venue gate (e.g. main entrance).
model Gate {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  zoneId    String?
  zone      Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceEvents AttendanceEvent[]

  @@index([eventId, name])
  @@index([zoneId])
}

/// Groups hotels for one cluster coordinator's oversight within an event. Optional:
/// a hotel with no cluster is simply ungrouped, never an error.
model Cluster {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotels  Hotel[]
  members EventMember[]

  @@index([eventId, name])
}

/// Registration of an attendee or coordinator for an event (staff have access to all events).
model EventMember {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Attendee's hotel allotment, or a hotel coordinator's assigned hotel (many
  /// coordinators may share one hotel — nothing here makes it exclusive). Read on
  /// every request so reassignment applies immediately.
  hotelId   String?
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  /// A cluster coordinator's assigned cluster. Unused by other roles.
  clusterId String?
  cluster   Cluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  /// Attendee's assigned seating/venue zone. Unused by other roles.
  zoneId    String?
  zone      Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  /// Attendee's assigned room at their hotel. Unused by other roles. Not
  /// enforced at the DB level to always match hotelId's hotel — the service
  /// layer checks that on assignment (see services/rooms.ts).
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@index([hotelId])
  @@index([clusterId])
  @@index([zoneId])
  @@index([roomId])
}

model Hotel {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  name      String
  address   String
  latitude  Float?
  longitude Float?
  notes     String?
  isActive  Boolean  @default(true)
  /// Optional grouping for a cluster coordinator's oversight.
  clusterId String?
  cluster   Cluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Hotel coordinators are EventMember rows with hotelId = this hotel and the
  /// user's role = COORDINATOR (looked up, not a direct relation — several
  /// coordinators may share a hotel; see services/hotels.ts).
  members EventMember[]
  buses   Bus[]
  rooms   Room[]

  @@index([eventId, isActive, name])
  @@index([clusterId])
}

/// One room's inventory at a hotel — number of beds/occupancy, for assigning
/// guests to specific rooms (Phase 4). A room belongs to one hotel; a guest's
/// room is tracked on their EventMember row, same pattern as zoneId.
model Room {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  /// e.g. "101" or "Room 12" — just a label, not necessarily a number.
  label     String
  /// Maximum occupancy (beds). Always required, unlike Zone.capacity, since
  /// an uncapped room has no real-world meaning.
  capacity  Int
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occupants EventMember[]

  @@unique([hotelId, label])
  @@index([hotelId, isActive])
}

model Bus {
  id            String   @id @default(cuid())
  /// Display name or number, e.g. "Bus 12".
  label         String
  registration  String?  @unique
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  /// This bus's one responsible coordinator; the active trip records who is actually on
  /// board. A coordinator is the responsible coordinator of at most one bus (unique).
  coordinatorId String?  @unique
  coordinator   User?    @relation("BusCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  routeNotes    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stops            BusStop[]
  trips            Trip[]
  location         BusLocation?
  statusEvents     BusStatusEvent[]
  attendanceEvents AttendanceEvent[]
  attendanceSessions AttendanceSession[]
  coordinatorAssignments BusCoordinatorAssignment[]

  @@index([hotelId, isActive])
}

/// Planned/historical record of who is responsible for a bus over a date
/// range — distinct from Bus.coordinatorId, which is the single *current*
/// responsible coordinator actually used for trip-starting and live
/// tracking. This is a read/scheduling layer on top of that, not a
/// replacement for it: changing a schedule here does not itself change who
/// can start a trip today. See PROJECT_MEMORY.md Phase 3 notes.
model BusCoordinatorAssignment {
  id            String    @id @default(cuid())
  busId         String
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Restrict)
  coordinatorId String
  coordinator   User      @relation("BusCoordinatorAssignment", fields: [coordinatorId], references: [id], onDelete: Restrict)
  startsOn      DateTime  @db.Date
  /// null = open-ended (no planned end yet).
  endsOn        DateTime? @db.Date
  notes         String?
  createdById   String
  createdBy     User      @relation("BusCoordinatorAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@index([busId, startsOn])
  @@index([coordinatorId, startsOn])
}

/// Ordered stops on a bus's current route. Editable as routes change.
model BusStop {
  id        String   @id @default(cuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  sequence  Int
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  /// Free-text schedule, e.g. "Departs 8:30 AM".
  timeNote  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([busId, sequence])
}

/// One run of a bus with a coordinator on board. A bus has at most one active
/// trip (endedAt IS NULL), enforced by a partial unique index in the migration.
model Trip {
  id              String    @id @default(cuid())
  busId           String
  bus             Bus       @relation(fields: [busId], references: [id], onDelete: Restrict)
  coordinatorId   String
  coordinator     User      @relation(fields: [coordinatorId], references: [id], onDelete: Restrict)
  status          BusStatus @default(BOARDING_AT_VENUE)
  statusChangedAt DateTime  @default(now())
  /// Incremented on every status change; clients send it back to reject stale updates.
  statusVersion   Int       @default(0)
  /// Independent of status/leg: can be set while on any leg, cleared when it clears.
  isDelayed       Boolean   @default(false)
  /// Trip ended because it was called off, not completed. endedAt is set either way;
  /// this distinguishes why, for history/dashboard purposes.
  cancelled       Boolean   @default(false)
  sharingLocation Boolean   @default(false)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  statusEvents    BusStatusEvent[]
  locationHistory LocationPoint[]
  currentLocation BusLocation?

  @@index([busId, endedAt])
  @@index([coordinatorId, endedAt])
}

/// Latest known position per bus. One row per bus, overwritten in place.
model BusLocation {
  busId      String   @id
  bus        Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  tripId     String   @unique
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  /// Reported accuracy in metres.
  accuracy   Float?
  /// Device timestamp; newer readings only replace older ones.
  recordedAt DateTime
  receivedAt DateTime @default(now())
}

/// Optional, sampled trip history. Pruned according to EventConfig.locationRetentionDays.
model LocationPoint {
  id         BigInt   @id @default(autoincrement())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt DateTime

  @@index([tripId, recordedAt])
  @@index([recordedAt])
}

model BusStatusEvent {
  id          String    @id @default(cuid())
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  busId       String
  bus         Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  /// The status before this change (null for a trip's first event — there is no "from").
  fromStatus  BusStatus?
  status      BusStatus
  changedById String?
  changedBy   User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([tripId, createdAt])
  @@index([busId, createdAt])
}

/// Append-only attendance/movement trail for one attendee — check-in/out at the
/// venue, or boarding/departing a bus. Never updated or deleted; a correction
/// is simply a new event. "Current" status is derived from the latest event.
model AttendanceEvent {
  id      String         @id @default(cuid())
  eventId String
  event   Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId  String
  user    User           @relation("AttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  type    AttendanceType
  /// Set for CHECK_IN/CHECK_OUT only.
  gateId  String?
  gate    Gate?          @relation(fields: [gateId], references: [id], onDelete: SetNull)
  /// Set for BOARD/DEPART only.
  busId        String?
  bus          Bus?      @relation(fields: [busId], references: [id], onDelete: SetNull)
  recordedById String
  recordedBy   User      @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())

  @@index([eventId, userId, createdAt])
  @@index([busId, createdAt])
  @@index([gateId])
}

/// A dated roll-call for one bus (e.g. "Day 1 morning boarding"). Replaces the
/// old live-only boarding list: a session is a record you can create, revisit
/// and edit later, not just the bus's current moment-to-moment state.
model AttendanceSession {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  busId       String
  bus         Bus      @relation(fields: [busId], references: [id], onDelete: Restrict)
  date        DateTime @db.Date
  /// Free-text label distinguishing more than one session on the same day for
  /// the same bus (e.g. "Morning" / "Return trip"); "" means no label given.
  /// Not nullable — Postgres treats every NULL as distinct in a unique index,
  /// which would silently defeat the duplicate-session guard below for the
  /// common case of two unlabeled sessions on the same day.
  label       String   @default("")
  createdById String
  createdBy   User     @relation("AttendanceSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  records AttendanceRecord[]

  // Guards against an accidental duplicate create (same bus, same day, same
  // label) at the database level, not just in the UI.
  @@unique([busId, date, label])
  @@index([eventId, date])
}

/// One guest's mark within one AttendanceSession. "Total/Boarded/Absent" counts
/// are always derived from these rows plus the hotel's roster, never stored —
/// so they can't drift out of sync when a record changes.
model AttendanceRecord {
  id           String            @id @default(cuid())
  sessionId    String
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation("AttendanceRecordSubject", fields: [userId], references: [id], onDelete: Cascade)
  mark         AttendanceMark
  /// Optional reason, mainly for ABSENT.
  note         String?
  recordedById String
  recordedBy   User              @relation("AttendanceRecordRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime          @default(now())
  /// Incremented on every change; a stale write (two coordinators marking the
  /// same guest at once) is rejected rather than silently overwritten — same
  /// pattern as Trip.statusVersion.
  version      Int               @default(0)

  // One mark per guest per session; recordMark() upserts against this.
  @@unique([sessionId, userId])
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  /// Event the user is currently working in; re-validated on every request.
  eventId    String?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window counters for rate limiting (OTP requests, verification attempts).
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  /// Changed fields only. Never store OTPs, tokens or secrets here.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

/// Platform-wide operational settings (all events). Single row with id = 1.
model EventConfig {
  id                       Int      @id @default(1)
  /// Locations older than this are shown as stale.
  staleLocationSeconds     Int      @default(120)
  /// Detailed GPS history older than this is deleted.
  locationRetentionDays    Int      @default(7)
  /// Minimum seconds between stored history points per trip.
  historySampleSeconds     Int      @default(30)
  updatedAt                DateTime @updatedAt
}
